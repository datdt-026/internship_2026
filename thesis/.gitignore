# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Secrets / local env — real tokens only in .env (never in .env.example)
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Large artifacts (keep directory via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
results/*
!results/.gitkeep
!results/.gitkeep

# Model caches
.cache/
huggingface/
*.bin
*.pt
*.pth
*.ckpt
*.safetensors

# Logs
logs/
wandb/
runs/
*.log
